DATABASE_URL=postgres://sales:sales@localhost:5435/sales_crm
# At least 32 random characters: node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=

# Optional: email managers when a salesman secures a deal. Leave SMTP_HOST empty to turn email off.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="AP Plus Sales CRM <sales-crm@applus.com.sa>"
# Link in the email, e.g. http://192.168.0.119:3600
APP_URL=
